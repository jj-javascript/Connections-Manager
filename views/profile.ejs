<!doctype html>
<html style="background-image: url('../img.crumple.jpg');">
<head>
    <title>Networking Manager</title>
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/bootstrap/3.0.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/font-awesome/4.0.3/css/font-awesome.min.css">
    <link rel="stylesheet" href="style.css">
    <script src="https://kit.fontawesome.com/c56b547e95.js" crossorigin="anonymous"></script>
  </head>
<body>
<div class="container">

    <div class="page-header text-center">
        <h1><span class="fa fa-anchor"></span> Profile Page</h1>
        <a href="/logout" class="btn btn-default btn-sm">Logout</a>
    </div>

    <div class="row">

        <!-- LOCAL INFORMATION -->
        <div class="col-sm-6">
            <div class="well">
                <h3><span class="fa fa-user"></span> Local</h3>

                <% if (user.local.email) { %>
                    <p>
                        <strong>id</strong>: <%= user._id %><br>
                        <strong>email</strong>: <%= user.local.email %><br>
                        <strong>password</strong>: <%= user.local.password %>
                    </p>

                    <a href="/unlink/local" class="btn btn-default">Unlink</a>
                <% } else { %>
                    <a href="/connect/local" class="btn btn-default">Connect Local</a>
                <% } %>

            </div>
        </div>
        <div class="col-sm-6">
          <h3>Contacts</h3>
          <ul class="messages">
          <% for(var i=0; i<messages.length; i++) {%>
            <li class="message">
              <span><%= messages[i].firstName %></span>
              <span><%= messages[i].lastName %></span>
              <span><%= messages[i].email %></span>
              <span><%= messages[i].telephone %></span>
              <span><%= messages[i].company %></span>
              <span><%= messages[i].event %></span>
              <span><%= messages[i].spark %></span>
              <span><%= messages[i].followups %></span>
              <span class="id"><%= messages[i]._id %></span>
              <span><i class="<%= messages[i].favorite ? 'fa-solid' : 'fa-regular' %> fa-star"></i></span>
              <span><i class="fa fa-trash" aria-hidden="true"></i></span>
            </li>
          <% } %>
          </ul>

          <h2>Add a Contact</h2>
        <% if (user.local.email) { %>
          <form action="/messages" method="POST">
            <input type="text" name="firstName" placeholder="First Name">
            <input type="text" name="lastName" placeholder="Last Name">
            <input type="email" name="email" placeholder="E-mail">
            <input type="tel" name="telephone" placeholder="Phone Number">
            <input type="text" name="company" placeholder="Company">
            <input type="text" name="event" placeholder="Event">
            <input type="text" name="spark" placeholder="Spark">
            <input type="text" name="followups" placeholder="Actionable Items">
            <button type="submit">Add Contact</button>
          </form>
        </div>
        <% } %>

</div>

<script src="main.js"></script>

</body>
</html>
